{
  "name": "git-profile-map",
  "version": "0.3.1",
  "private": true,
  "description": "See and switch the Git identity and SSH or HTTPS profile used by a repository",
  "author": {
    "name": "Marco",
    "email": "marcoromoli95@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mromoli/git-profile-map.git"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "screenshots": "electron scripts/screenshots.cjs"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.gitprofilemap.desktop",
    "productName": "Git Profile Map",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "artifactName": "Git-Profile-Map-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "nsis": {
      "artifactName": "Git-Profile-Map-Setup-${version}.${ext}",
      "differentialPackage": false
    },
    "appImage": {
      "artifactName": "Git-Profile-Map-${version}.${ext}"
    }
  }
}
